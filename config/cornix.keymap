/* Cornix LP adaptation of s-hiraoku/KobitoKey_QWERTY.
 * Source commit: 35b175d2717d9d09373212c6f93f6aa80deb338a
 * Generated by scripts/import_kobitokey.py; edit the adapter,
 * then regenerate the keymap/SVG and run the tests.
 * Trackball input processors are absent: Cornix has no such sensor.
 * Keyboard layers 0/1/2/3 and source BT layer 8 (now 4) remain.
 * Default Y/H/P are plain letters; trackball-only modes are removed.
 * Unused positions are &none; no encoder actions are added.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        /* 英数/かなは全レイヤーで有効。オート発動レイヤー滞在中でも
         * IME 切替を優先し、マウスボタン等への誤爆を防ぐ。
         * 2 本指の押下が 50ms を超えてズレると発動せず df/jk が
         * 出るため 80ms に延長。D+F / J+K のロールはローマ字にも英語にも
         * ほぼ出ないので誤発動リスクは低い。まだ取りこぼすなら 100 へ */
        combo_eisu {
            timeout-ms = <80>;
            key-positions = <15 16>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <80>;
            key-positions = <19 20>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <13 14>;
            bindings = <&kp TAB>;
        };

        combo_bt {
            timeout-ms = <50>;
            layers = <0>;
            key-positions = <44 46>;
            bindings = <&to 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEFAULT";
            bindings = <
                &none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none
                &none  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &none
                &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &none  &none  &kp N  &kp M  &kp COMMA  &kp DOT  &kp APOS  &none
                &kp LSHFT  &kp LALT  &kp LCMD  &none  &lt_l 1 SPACE  &kp LCTRL  &kp BSPC  &lt_r 2 ENTER  &lt_r 3 RSHFT  &none  &kp RALT  &mt RSHFT SLASH
            >;
        };

        layer1 {
            display-name = "FUNCTION";
            bindings = <
                &none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &none
                &none  &trans  &trans  &trans  &trans  &kp F6  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp F12  &none
                &none  &trans  &trans  &trans  &trans  &trans  &none  &none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp DEL  &none
                &trans  &trans  &trans  &none  &trans  &trans  &trans  &trans  &trans  &none  &trans  &trans
            >;
        };

        layer2 {
            display-name = "NUMBER";
            bindings = <
                &none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp PLUS  &kp MINUS  &kp ASTRK  &kp SLASH  &kp EQUAL  &none
                &none  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DOT  &kp COMMA  &kp LPAR  &kp RPAR  &kp PRCNT  &none
                &none  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &none
                &trans  &trans  &trans  &none  &trans  &trans  &kp DEL  &trans  &trans  &none  &trans  &trans
            >;
        };

        layer3 {
            display-name = "SYMBOL";
            bindings = <
                &none  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &kp TILDE  &kp GRAVE  &none
                &none  &kp LBRC  &kp RBRC  &kp LPAR  &kp RPAR  &kp EQUAL  &kp MINUS  &kp UNDER  &kp PIPE  &kp BSLH  &kp PLUS  &none
                &none  &kp LBKT  &kp RBKT  &kp LT  &kp GT  &kp QMARK  &none  &none  &kp SLASH  &kp DQT  &kp COLON  &kp SEMI  &kp APOS  &none
                &trans  &trans  &trans  &none  &trans  &trans  &trans  &trans  &trans  &none  &trans  &trans
            >;
        };

        layer4 {
            display-name = "BT";
            bindings = <
                &none  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
                &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &none
                &none  &bt BT_CLR  &bt BT_CLR_ALL  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &none
                &trans  &trans  &trans  &none  &trans  &to 0  &trans  &trans  &trans  &none  &to 0  &trans
            >;
        };

    };
};

/* lt (layer-tap) を hold-preferred + 短めの tapping-term に変更。
 * デフォルト (tap-preferred / 200ms) や balanced では押し方次第で
 * lt 3 RSHFT + `-` が `H` に化ける症状が残った。hold-preferred は
 * 別キーが押された瞬間に hold を確定するので、押し方を問わず Layer 入り
 * が確定する。副作用として lt 単独タップ (Space/Enter/RSHFT) を別キーと
 * 連続入力すると hold 誤判定されやすくなるため、tapping-term を 180ms
 * と短めにし、quick-tap-ms=125 で連続タップ時の取りこぼしを救う。
 *
 * require-prior-idle-ms は当初 150ms だったが、Layer 切替の反応が
 * 鈍く感じたため 90ms に短縮。タイピング後 90ms 経てば hold 判定が
 * 通常通り効くので、文章中の親指 lt も実用域。
 *
 * 注意: require-prior-idle-ms は修飾キーでは効かない (ZMK の
 * keycode_state_changed_listener は !is_mod() のキーでしか last_tapped を
 * 更新しない)。Cmd を押しっぱなしで親指 lt を 180ms 保持すると hold が
 * 確定して文字が消える。左親指の Space だけは lt_l の retro-tap で
 * 救ってある。 */
&lt {
    flavor = "hold-preferred";
    tapping-term-ms = <180>;
    quick-tap-ms = <125>;
    require-prior-idle-ms = <90>;
};

/* mt (mod-tap) も lt と同じ方針。&mt RSHFT SLASH (右親指 /) で
 * タイピング中に親指がかすって Shift+α に化けるのを防ぐため
 * require-prior-idle-ms を効かせる。 */
&mt {
    flavor = "hold-preferred";
    tapping-term-ms = <180>;
    quick-tap-ms = <125>;
    require-prior-idle-ms = <90>;
};

/ {
    behaviors {
        /* 左親指 lt。retro-tap は他のキーを押さずに離した時だけ tap へ
         * ロールバックするので、Cmd+Ctrl+Space / Cmd+Space の Space が
         * 消えなくなる (修飾キーは Space より先に押されるため hold-tap の
         * 言う『他のキーの押下』に数えられない)。Layer 1 の発動は次のキーを
         * 押す瞬間まで保留されるだけなので使い勝手は変わらない。
         * 副作用: 長押し中は Layer 1 未発動なので LED が光らない。
         * 離す時は Space を先に。修飾キーを先に離すと hold へ昇格する。
         *
         * positional hold-tap (hold-trigger-key-positions +
         * hold-trigger-on-release) は復活させないこと。hold-preferred が
         * 他キーの『押下』で hold を確定するのに対し、位置が記録されるのは
         * 『離した』時なので decide_positional_hold が常に空振りする。
         * そもそも positional は lt より後に押されたキーしか見ないため、
         * 修飾キーを先に押す並びは原理的に対象外。 */
        lt_l: lt_left_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <90>;
            bindings = <&mo>, <&kp>;
            retro-tap;
        };

        /* 右親指 lt。retro-tap は付けない。Layer 2/3 に入ろうとして
         * 思い直しただけで Enter が飛ぶ実害の方が大きいため。 */
        lt_r: lt_right_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <90>;
            bindings = <&mo>, <&kp>;
        };
    };
};
